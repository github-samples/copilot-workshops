---
const target = `${import.meta.env.BASE_URL}real-world-development/cli/7-qa-agent/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="en" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>Redirecting to Create and use a QA agent</title>
  </head>
  <body>
    <a href={target}>This lesson moved. Continue to Create and use a QA agent.</a>
  </body>
</html>
